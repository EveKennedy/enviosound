{
  "name": "enviosoundltd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.js",
    "dev:web": "vite --host 0.0.0.0",
    "api": "node server.js --api-only",
    "serve": "npm run build && node server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cap:sync": "npm run build && cap sync android",
    "cap:sync:android": "npm run build && cap sync android",
    "android": "npm run build && cap open android",
    "ios:capacitor": "npm run build && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.0"
  }
}
